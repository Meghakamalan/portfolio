extends common/layout

block content
  h1.greeting Skills
  
  div.action-bar
    a.btn-pill(href="/admin/skills/add") + Add a skill

  div.table-wrapper
    table.admin-table
      thead
        tr
          th Skill Name
          th Category
      tbody
        if skills.length === 0
          tr
            td(colspan="4" style="color: var(--text-muted); text-align: center; padding: 2rem;") No skills created yet.
        else
          each skill in skills
            tr
              td #[strong #{skill.name}]
              td #{skill.category}
              td
                div.table-actions
                  form(action=`/admin/skills/delete/${skill._id}` method="POST")
                    button.btn-action.btn-delete-pill(type="submit") Delete