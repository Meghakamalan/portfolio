extends common/layout

block content
  h1.greeting Add New Project
  
  div.form-panel(style="max-width: 600px; margin-top: 2rem;")
    form(action="/admin/projects/add" method="POST")
      div.form-group
        label Project Title
        input(type="text" name="title" required=true)
      div.form-group
        label Description
        textarea(name="description" rows="4" required=true)
      div.form-group
        label Technologies 
        input(type="text" name="techStack" placeholder="HTML, CSS, JavaScript" required=true)
      div(style="display: flex; gap: 1rem; margin-top: 1.5rem;")
        button.btn-submit(type="submit" style="width: auto; padding: 0.65rem 2rem;") Add Project
